{
    "name": "melon",
    "version": "0.1.0",
    "private": true,
    "description": "Melon canvas \u2014 desktop shell (Electron)",
    "main": "main.mjs",
    "scripts": {
        "start": "electron .",
        "dist:mac": "electron-builder --mac"
    },
    "dependencies": {
        "@earendil-works/pi-coding-agent": "^0.84.1",
        "@fastify/cors": "^10.0.2",
        "fastify": "^5.2.1",
        "@fastify/static": "10.1.3"
    },
    "devDependencies": {
        "electron": "^43.4.1",
        "electron-builder": "^25.1.8"
    },
    "type": "module",
    "productName": "Melon",
    "build": {
        "appId": "com.melon.canvas",
        "productName": "Melon",
        "directories": {
            "output": "dist",
            "buildResources": "build"
        },
        "files": [
            "main.mjs",
            "preload.cjs",
            "server/**/*",
            "web-dist/**/*",
            "package.json"
        ],
        "mac": {
            "category": "public.app-category.developer-tools",
            "target": [
                "dmg"
            ],
            "identity": null
        },
        "asarUnpack": [
            "node_modules/@earendil-works/pi-coding-agent/**/*"
        ]
    }
}