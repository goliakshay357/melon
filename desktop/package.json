{
    "name": "melon",
    "version": "0.3.2",
    "private": true,
    "description": "Melon canvas — desktop shell (Electron)",
    "main": "main.mjs",
    "scripts": {
        "start": "electron .",
        "dist:mac": "electron-builder --mac"
    },
    "dependencies": {
        "@earendil-works/pi-coding-agent": "0.84.1",
        "@fastify/cors": "10.0.2",
        "@fastify/static": "10.1.3",
        "diff": "8.0.4",
        "fastify": "5.2.1",
        "pi-cursor-sdk": "0.3.6"
    },
    "devDependencies": {
        "electron": "43.4.1",
        "electron-builder": "25.1.8"
    },
    "type": "module",
    "productName": "Melon",
    "build": {
        "appId": "com.melon.canvas",
        "productName": "Melon",
        "artifactName": "Melon-${version}-${arch}.${ext}",
        "directories": {
            "output": "dist",
            "buildResources": "build"
        },
        "files": [
            "main.mjs",
            "preload.cjs",
            "server/**/*",
            "web-dist/**/*",
            "package.json"
        ],
        "mac": {
            "category": "public.app-category.developer-tools",
            "target": [
                "dmg"
            ],
            "identity": null
        },
        "asarUnpack": [
            "node_modules/@earendil-works/pi-coding-agent/**/*",
            "node_modules/pi-cursor-sdk/**/*",
            "node_modules/@cursor/**/*",
            "node_modules/@connectrpc/**/*",
            "node_modules/@modelcontextprotocol/**/*",
            "node_modules/@hono/**/*",
            "node_modules/@buf/**/*"
        ]
    }
}
